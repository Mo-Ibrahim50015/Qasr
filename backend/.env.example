# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL 16)
DATABASE_URL="postgresql://qasr_user:qasr_password_secure@localhost:5432/qasr_al_otoor?schema=public"

# Redis Cache
REDIS_URL="redis://localhost:6379"

# Authentication & Security
JWT_SECRET="super-secret-jwt-key-replace-in-production-qasr-2026"
JWT_REFRESH_SECRET="super-secret-refresh-jwt-key-replace-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Google OAuth 2.0
GOOGLE_CLIENT_ID="mock-google-client-id"
GOOGLE_CLIENT_SECRET="mock-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:5000/api/v1/auth/google/callback"

# Paymob Integration (EGP)
PAYMOB_API_KEY="mock_paymob_api_key"
PAYMOB_INTEGRATION_ID_CARD="123456"
PAYMOB_INTEGRATION_ID_WALLET="123457"
PAYMOB_IFRAME_ID="789012"
PAYMOB_HMAC_SECRET="mock_paymob_hmac_secret"

# Cloudflare R2 Storage (Object storage for product images)
R2_ACCOUNT_ID="mock_r2_account_id"
R2_ACCESS_KEY_ID="mock_r2_access_key"
R2_SECRET_ACCESS_KEY="mock_r2_secret_key"
R2_BUCKET_NAME="qasr-images"
R2_PUBLIC_DOMAIN="https://images.qasralotoor.com"

# SMS & OTP Provider (Egypt mobile 01X)
SMS_PROVIDER_API_KEY="mock_sms_api_key"
SMS_SENDER_NAME="QasrOtoor"

